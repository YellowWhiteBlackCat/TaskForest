<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.YellowWhiteBlackCat.TaskForest.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/taskforest-daemon</string>
        <string>--user</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/taskforest-daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/taskforest-daemon.stderr.log</string>
</dict>
</plist>
