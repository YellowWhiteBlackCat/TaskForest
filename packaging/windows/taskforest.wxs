<?xml version="1.0" encoding="UTF-8"?>
<!--
  TaskForest Windows installer (WiX v4+ schema, built by `wix build`).

  Per-machine install of the GPUI frontend into Program Files, with one Start
  Menu shortcut. History persistence is owned by the running frontend session.
  Design notes:

  - No service or autostart registration is installed by this MSI.
  - The identity-checked Windows UAC process-control helper ships next to the
    GPUI executable. Other privileged helpers and Linux polkit policies remain
    Linux-native and are not part of this MSI.
  - AllowSameVersionUpgrades lets an rc build (numeric version collared to
    x.y.z) upgrade in place for the final release.
  - Unsigned until an Authenticode secret exists; SmartScreen will warn.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="$(var.ProductName)"
           Manufacturer="TaskForest contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Compressed="yes"
           Language="1033"
           Codepage="65001">
    <!-- ProductVersion must stay numeric (Windows Installer hard requirement);
         the full Cargo version (prerelease rcN included) is carried in the
         summary metadata, the ARP comments, and the Software\TaskForest
         Version registry value below. -->
    <SummaryInformation Description="$(var.ProductName) $(var.FullVersion) — eye-friendly native system monitor" />
    <Property Id="ARPCOMMENTS" Value="$(var.ProductName) $(var.FullVersion) — eye-friendly native system monitor" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of TaskForest is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="TaskForest.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="TaskForest.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TaskForest">
        <Component Id="TaskForestExecutable" Guid="$(var.ComponentGuid)">
          <File Id="TaskForestExe" Source="$(var.StageDir)/$(var.ExeName)" KeyPath="yes" />
        </Component>
        <Component Id="TaskForestProcessControlHelper" Guid="8D2D0F43-CB9A-4B2E-8A45-5DF8F6C56E1B">
          <File Id="TaskForestProcessControlHelperExe"
                Source="$(var.StageDir)/taskmanager-process-control-helper.exe"
                KeyPath="yes" />
        </Component>
        <Component Id="LicenseNotice" Guid="691EEA03-C18E-46DC-9A5B-26FC9813C76C">
          <File Id="LicenseFile" Source="$(var.StageDir)/LICENSE" />
        </Component>
        <Component Id="ThirdPartyNotices" Guid="1BB818B1-4A90-4020-9DC9-0A6A43E0AB78">
          <File Id="ThirdPartyNoticesFile" Source="$(var.StageDir)/THIRD-PARTY-NOTICES.txt" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="TaskForest">
        <Component Id="StartMenuShortcut" Guid="$(var.ShortcutGuid)">
          <Shortcut Id="TaskForestShortcut"
                    Name="$(var.ShortcutName)"
                    Description="Eye-friendly native system monitor"
                    Target="[INSTALLFOLDER]$(var.ExeName)"
                    Icon="TaskForest.ico"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
          <RegistryValue Root="HKLM"
                         Key="Software\TaskForest"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
          <RegistryValue Root="HKLM"
                         Key="Software\TaskForest"
                         Name="Version"
                         Type="string"
                         Value="$(var.FullVersion)" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Install-time UI: welcome → license → install-directory choice →
         install. WixUI_InstallDir is the minimal standard set that lets the
         user pick INSTALLFOLDER instead of always landing in Program Files;
         the RTF for the license dialog is bound by build-msi.sh. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>
</Wix>
