# Maintainer: TaskForest contributors
pkgname=taskforest-bin
pkgver=0.1.0.rc.3
_tag=v0.1.0-rc.3
pkgrel=1
pkgdesc='Eye-friendly native system monitor built with GPUI (official release binaries)'
arch=('x86_64')
url='https://github.com/YellowWhiteBlackCat/TaskForest'
license=('Apache-2.0')
# Same runtime closure as packaging/arch/PKGBUILD (taskforest-git); see the
# dlopen rationale there for why the Vulkan loader is a hard dependency.
depends=('fontconfig' 'freetype2' 'libxkbcommon' 'wayland' 'vulkan-icd-loader')
optdepends=('polkit: OS-native prompts for the per-feature privilege helpers'
            'smartmontools: ATA/SATA/NVMe S.M.A.R.T. attributes and self-tests'
            'nvme-cli: extra NVMe endurance/power-on-hours data'
            'xfsprogs: XFS filesystem integrity checks'
            'iw: WiFi SSID display'
            'nvidia-utils: NVIDIA GPU utilization via dynamically loaded NVML'
            'vulkan-intel: Vulkan ICD for Intel integrated graphics'
            'vulkan-radeon: Vulkan ICD for AMD graphics')
provides=('taskforest')
conflicts=('taskforest')
# Keep the installed bytes identical to the checksummed release asset.
options=('!strip')
source=("${url}/releases/download/${_tag}/taskforest_${_tag#v}_amd64.deb")
sha256sums=('aa6bea3e8ed5007dc60e236f5d8e31c51fd336f96804c5867c3cf4f10ec467b9')
# makepkg (bsdtar) unpacks the deb's ar members into srcdir; the data payload
# was staged by packaging/linux/stage-release-tree.sh replaying the layout
# authority (packaging/arch/PKGBUILD package()), so extracting it verbatim
# keeps Arch -bin installs file-for-file identical to the deb/rpm by
# construction.
noextract=("taskforest_${_tag#v}_amd64.deb")

prepare() {
  cd "$srcdir"
  bsdtar -xf "taskforest_${_tag#v}_amd64.deb" data.tar.zst
}

package() {
  cd "$srcdir"
  bsdtar -xf data.tar.zst -C "$pkgdir" --no-same-owner
}
