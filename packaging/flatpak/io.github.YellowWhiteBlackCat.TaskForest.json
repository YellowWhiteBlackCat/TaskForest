{
  "app-id": "io.github.YellowWhiteBlackCat.TaskForest",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "taskforest-g",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=/proc:ro",
    "--filesystem=/sys:ro",
    "--filesystem=xdg-run/taskforest:create",
    "--system-talk-name=org.freedesktop.login1",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/taskforest/cargo"
    }
  },
  "modules": [
    {
      "name": "taskforest",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release -p taskmanager-gpui --bin taskforest-g",
        "install -Dm755 target/release/taskforest-g /app/bin/taskforest-g",
        "install -Dm644 packaging/linux/io.github.YellowWhiteBlackCat.TaskForestG.desktop /app/share/applications/io.github.YellowWhiteBlackCat.TaskForest.desktop",
        "install -Dm644 packaging/linux/io.github.YellowWhiteBlackCat.TaskForestG.metainfo.xml /app/share/metainfo/io.github.YellowWhiteBlackCat.TaskForest.metainfo.xml",
        "install -Dm644 packaging/linux/io.github.YellowWhiteBlackCat.TaskForest.svg /app/share/icons/hicolor/scalable/apps/io.github.YellowWhiteBlackCat.TaskForest.svg",
        "for size in 16 24 32 48 64 128 256 512; do install -Dm644 packaging/linux/icons/hicolor/${size}x${size}/apps/io.github.YellowWhiteBlackCat.TaskForest.png /app/share/icons/hicolor/${size}x${size}/apps/io.github.YellowWhiteBlackCat.TaskForest.png; done"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
