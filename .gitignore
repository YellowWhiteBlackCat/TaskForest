# Generated by Cargo (compiled files / executables)
/target
target
# Stray root-level build output dir (cargo itself only ever writes target/…)
/debug

# Stray build outputs (e.g. a misnamed `rust_out` binary from a botched build)
rust_out

# rustfmt backup files
**/*.rs.bk

# MSVC Windows builds of rustc generate these (debugging info)
*.pdb

# cargo mutants output
**/mutants.out*/

# Nested-compositor screenshot capture scratch dirs
/tmp/tm-*

# Regenerated matrix overview (scripts/capture-niri.sh montage); run dir copy is enough
docs/screenshots/contact-sheet.png

# JetBrains IDE and VS Code folders
.idea/
.vscode/
*.swp
*~

# Python bytecode caches (evidence-validator / build scripts)
__pycache__/
*.pyc

# Local agent runtime configurations and scratch — private, never commit.
.claude/
.claude.json
claude.json
.codex/
.zcode/

# Agent scratch + Cargo temp on NVMe (scripts/agent-workdir.sh) — never commit
.tmp/
.cargo-tmp

# Private publication-preparation material. This directory is intentionally
# outside the public documentation contract and must never be committed.
.private/

# Local security-scan findings, reports and scan history — private material.
.mimosa/

# UI captures are host evidence, not public product assets. Only the policy
# README is publishable; generated images and receipts stay local.
docs/screenshots/*
!docs/screenshots/README.md

# Host-specific installation observations are local receipts.
docs/system-install-host-receipt.tsv

# makepkg working state under packaging/arch (never publish build artifacts)
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.pkg.tar.*
packaging/arch/bin/src/
packaging/arch/bin/pkg/
packaging/arch/bin/*.pkg.tar.*
packaging/arch/bin/*.deb
